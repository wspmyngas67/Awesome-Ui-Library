            Create("UIPadding", {
                PaddingTop = UDim.new(0, 4),
                PaddingBottom = UDim.new(0, 4),
                PaddingLeft = UDim.new(0, 4),
                PaddingRight = UDim.new(0, 4),
                Parent = list,
            })
            
            local optionButtons = {}
            local expanded = false
            
            local function updateDisplay()
                local selectedList = {}
                for k, v in pairs(selected) do
                    if v then table.insert(selectedList, k) end
                end
                if #selectedList == 0 then
                    valueLabel.Text = "None"
                elseif #selectedList == 1 then
                    valueLabel.Text = selectedList[1]
                else
                    valueLabel.Text = selectedList[1] .. " (+" .. (#selectedList - 1) .. ")"
                end
                
                local returnVal
                if multi then
                    returnVal = selectedList
                else
                    returnVal = selectedList[1]
                end
                if flag then Library.Flags[flag] = returnVal end
                callback(returnVal)
            end
            
            local function setExpanded(state)
                expanded = state
                list.Visible = state
                local count = #options
                local h = count * 26 + 8
                Tween(list, 0.2, {Size = state and UDim2.new(1, 0, 0, h) or UDim2.new(1, 0, 0, 0)})
                arrow.Text = state and "▲" or "▼"
            end
            
            local function refreshOptions(newOptions)
                options = newOptions or options
                for _, b in pairs(optionButtons) do b:Destroy() end
                optionButtons = {}
                
                for i, opt in ipairs(options) do
                    local optBtn = Create("TextButton", {
                        Size = UDim2.new(1, 0, 0, 24),
                        BackgroundColor3 = selected[opt] and Library.Theme.Accent or Library.Theme.Secondary,
                        Text = "  " .. tostring(opt),
                        TextColor3 = Library.Theme.Text,
                        Font = Enum.Font.Gotham,
                        TextSize = 12,
                        TextXAlignment = Enum.TextXAlignment.Left,
                        BorderSizePixel = 0,
                        LayoutOrder = i,
                        ZIndex = 51,
                        Parent = list,
                    })
                    Corner(4).Parent = optBtn
                    
                    optBtn.MouseButton1Click:Connect(function()
                        if multi then
                            selected[opt] = not selected[opt] or nil
                            optBtn.BackgroundColor3 = selected[opt] and Library.Theme.Accent or Library.Theme.Secondary
                        else
                            for k in pairs(selected) do selected[k] = nil end
                            selected[opt] = true
                            for o, b in pairs(optionButtons) do
                                if o == opt then b.BackgroundColor3 = Library.Theme.Accent
                                else b.BackgroundColor3 = Library.Theme.Secondary end
                            end
                            setExpanded(false)
                        end
                        updateDisplay()
                    end)
                    
                    optionButtons[opt] = optBtn
                end
            end
            
            btn.MouseButton1Click:Connect(function()
                setExpanded(not expanded)
            end)
            
            refreshOptions()
            if next(selected) then updateDisplay() end
            
            local obj = {}
            obj.Set = function(v)
                for k in pairs(selected) do selected[k] = nil end
                if type(v) == "table" then
                    for _, val in ipairs(v) do selected[val] = true end
                else
                    selected[v] = true
                end
                for o, b in pairs(optionButtons) do
                    b.BackgroundColor3 = selected[o] and Library.Theme.Accent or Library.Theme.Secondary
                end
                updateDisplay()
            end
            obj.Refresh = function(newOpts) refreshOptions(newOpts) end
            obj.Get = function()
                local list_ = {}
                for k, v in pairs(selected) do if v then table.insert(list_, k) end end
                return multi and list_ or list_[1]
            end
            return obj
        end
        
        function tab:AddTextbox(config)
            config = config or {}
            local text = config.Text or "Input"
            local default = config.Default or ""
            local placeholder = config.Placeholder or "Type here..."
            local flag = config.Flag
            local callback = config.Callback or function() end
            
            local holder = Create("Frame", {
                Size = UDim2.new(1, 0, 0, 32),
                BackgroundColor3 = Library.Theme.Secondary,
                BorderSizePixel = 0,
                Parent = page,
            })
            Corner(6).Parent = holder
            Stroke(Library.Theme.Border, 1).Parent = holder
            
            Create("TextLabel", {
                Size = UDim2.new(0.4, 0, 1, 0),
                Position = UDim2.new(0, 12, 0, 0),
                BackgroundTransparency = 1,
                Text = text,
                TextColor3 = Library.Theme.Text,
                Font = Enum.Font.Gotham,
                TextSize = 13,
                TextXAlignment = Enum.TextXAlignment.Left,
                Parent = holder,
            })
            
            local box = Create("TextBox", {
                Size = UDim2.new(0.55, -12, 0, 24),
                Position = UDim2.new(0.45, 0, 0.5, -12),
                BackgroundColor3 = Library.Theme.Tertiary,
                Text = default,
                PlaceholderText = placeholder,
                PlaceholderColor3 = Library.Theme.SubText,
                TextColor3 = Library.Theme.Text,
                Font = Enum.Font.Gotham,
                TextSize = 12,
                BorderSizePixel = 0,
                Parent = holder,
            })
            Corner(4).Parent = box
            Create("UIPadding", {
                PaddingLeft = UDim.new(0, 8),
                PaddingRight = UDim.new(0, 8),
                Parent = box,
            })
            
            box.Focused:Connect(function()
                Tween(box, 0.15, {BackgroundColor3 = Library.Theme.Accent})
            end)
            box.FocusLost:Connect(function()
                Tween(box, 0.15, {BackgroundColor3 = Library.Theme.Tertiary})
                if flag then Library.Flags[flag] = box.Text end
                callback(box.Text)
            end)
            
            local obj = {}
            obj.Set = function(v) box.Text = v; if flag then Library.Flags[flag] = v end end
            obj.Get = function() return box.Text end
            return obj
        end
        
        function tab:AddKeybind(config)
            config = config or {}
            local text = config.Text or "Keybind"
            local default = config.Default or Enum.KeyCode.E
            local flag = config.Flag
            local callback = config.Callback or function() end
            
            local holder = Create("Frame", {
                Size = UDim2.new(1, 0, 0, 32),
                BackgroundColor3 = Library.Theme.Secondary,
                BorderSizePixel = 0,
                Parent = page,
            })
            Corner(6).Parent = holder
            Stroke(Library.Theme.Border, 1).Parent = holder
            
            Create("TextLabel", {
                Size = UDim2.new(0.5, 0, 1, 0),
                Position = UDim2.new(0, 12, 0, 0),
                BackgroundTransparency = 1,
                Text = text,
                TextColor3 = Library.Theme.Text,
                Font = Enum.Font.Gotham,
                TextSize = 13,
                TextXAlignment = Enum.TextXAlignment.Left,
                Parent = holder,
            })
            
            local keyBtn = Create("TextButton", {
                Size = UDim2.new(0, 80, 0, 24),
                Position = UDim2.new(1, -92, 0.5, -12),
                BackgroundColor3 = Library.Theme.Tertiary,
                Text = default.Name,
                TextColor3 = Library.Theme.Text,
                Font = Enum.Font.Gotham,
                TextSize = 12,
                BorderSizePixel = 0,
                Parent = holder,
            })
            Corner(4).Parent = keyBtn
            
            local current = default
            local listening = false
            
            keyBtn.MouseButton1Click:Connect(function()
                listening = true
                keyBtn.Text = "..."
            end)
            
            UserInputService.InputBegan:Connect(function(input, gpe)
                if listening and input.UserInputType == Enum.UserInputType.Keyboard then
                    current = input.KeyCode
                    keyBtn.Text = current.Name
                    listening = false
                    if flag then Library.Flags[flag] = current end
                    callback(current)
                end
            end)
            
            local obj = {}
            obj.Get = function() return current end
            obj.Set = function(k) current = k; keyBtn.Text = k.Name end
            return obj
        end
        
        -- Auto-select first tab
        if not Window.ActiveTab then
            Window:SelectTab(tab)
        end
        
        table.insert(Window.Tabs, tab)
        return tab
    end
    
    function Window:SetToggleKey(key)
        Library.ToggleKey = key
    end
    
    return Window
end

return Library
